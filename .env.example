# TMDB (탐색 검색·트렌딩)
TMDB_API_KEY=
# https://www.themoviedb.org/settings/api
# 셸에 빈 TMDB_API_KEY= 가 있으면 .env.local이 무시됩니다. unset TMDB_API_KEY 후 재시작.

# 공유 미리보기(OG) 절대 URL 기준 — 선택. 비우면 Vercel 프로덕션 도메인 → localhost 순
# NEXT_PUBLIC_SITE_URL=https://mongle-steel.vercel.app

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings → API 에서 복사
